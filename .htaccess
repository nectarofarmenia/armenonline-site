# Security headers
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
</IfModule>
Options -Indexes

# Security headers: HTTPS only for a year, hide the PHP version
<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000"
Header always unset X-Powered-By
Header unset X-Powered-By
</IfModule>

# HTML always revalidated, so visitors get site updates right away
<IfModule mod_headers.c>
<FilesMatch "\.html$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>

# One-time per browser: drop any old cached pages left from the previous nectarofarmenia.com site
<IfModule mod_setenvif.c>
SetEnvIf Cookie "nofa_cc=1" NOFA_CC
</IfModule>
<IfModule mod_headers.c>
<FilesMatch "\.html$">
Header always set Clear-Site-Data "\"cache\"" env=!NOFA_CC
Header always add Set-Cookie "nofa_cc=1; Max-Age=31536000; Path=/; Secure; SameSite=Lax" env=!NOFA_CC
</FilesMatch>
</IfModule>

# Old-site links (from Google etc.) that no longer exist go to the home page
<IfModule mod_rewrite.c>
RewriteEngine On
# Short links printed on cards: /wholesale and /wholesale/join
RewriteRule ^wholesale/?$ /Wholesale.dc.html [R=302,L]
RewriteRule ^wholesale/join/?$ /Wholesale.dc.html#apply [R=302,NE,L]
# Invitation links with preview card: /i/CODE (retail), /iw/CODE (wholesale)
RewriteRule ^i/([A-Za-z0-9]{1,16})/?$ /invite.php?r=$1 [L,QSA]
RewriteRule ^iw/([A-Za-z0-9]{1,16})/?$ /invite.php?r=$1&w=1 [L,QSA]
# Unrendered template image paths ({{...}}) asked by the browser before the page script fills them: answer 404 at once, never redirect to the home page
RewriteRule \{\{ - [R=404,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_URI} !\.(png|jpe?g|webp|gif|svg|ico|css|js|json|pdf|woff2?|txt|xml|map)$ [NC]
RewriteRule ^ / [R=302,L]
</IfModule>

# Speed: compress text files and let browsers keep images, fonts and scripts (image names change when the picture changes)
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript text/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 30 days"
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType text/css "access plus 1 day"
ExpiresByType application/javascript "access plus 1 day"
</IfModule>
